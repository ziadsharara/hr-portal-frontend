# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
.vite/

# Any local env file (.env, .env.compose, .env.local, ...) — never commit
# real credentials. Keep the checked-in .example templates tracked.
.env*
!.env*.example

# Terraform (** so this also catches nested infra subdirectories, not
# just infra/ itself)
infra/**/.terraform/
infra/**/*.tfstate*
infra/**/*.tfplan
infra/**/.terraform.lock.hcl
infra/**/*.tfvars
!infra/**/*.tfvars.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
