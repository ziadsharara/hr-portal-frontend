# Rendered by the nginx-unprivileged image's built-in envsubst entrypoint
# (envsubst runs on every *.template file in /etc/nginx/templates/ at
# container start) into /etc/nginx/conf.d/default.conf. BACKEND_HOST /
# BACKEND_PORT differ between local docker-compose (service name
# "backend") and AWS (unused there — the ALB routes /api/* straight to
# the backend target group before it ever reaches this container; this
# proxy only matters for local dev, where there's no ALB in front).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Container/ALB health check target.
    location = /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    # Same-origin API calls (VITE_API_BASE_URL defaults to the relative
    # path /api) get proxied to the backend container. The backend's own
    # context-path is also /api, and proxy_pass here has no URI
    # component, so the full incoming path (including /api) is forwarded
    # unchanged.
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Vue Router history mode: any path that isn't a real static file
    # falls back to index.html so client-side routing can take over
    # instead of nginx 404ing on a hard refresh of e.g. /employees/42.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Long-cache immutable hashed build assets; never cache index.html
    # itself so deploys are picked up on next load.
    location ~* \.(?:js|css|woff2?|png|jpg|jpeg|svg|ico)$ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
